---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Ghana Day in Tampa Bay"
  description="The page you're looking for doesn't exist. Head back to Ghana Day in Tampa Bay."
>
  <section class="section-light section-padding flex min-h-[calc(60vh-var(--site-header-height,4.5rem))] flex-col items-center justify-center pt-[var(--site-header-height,4.5rem)] text-center">
    <h1 class="text-ghana-gold">404</h1>
    <p class="mt-4 max-w-md text-body text-ink/80">
      This page couldn't be found. Let's get you back to the celebration.
    </p>
    <a href="/" class="btn-primary mt-8">Back to Home</a>
  </section>
</BaseLayout>
