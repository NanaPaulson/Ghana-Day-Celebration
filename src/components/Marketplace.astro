---
import { cultureImages } from '../data/culture-images';
import { marketplaceItems } from '../data/pulse';
---

<section id="marketplace" data-header-theme="dark" class="pulse-section relative min-h-[70vh]">
  <div class="section-bg-image" aria-hidden="true">
    <img src={cultureImages.marketplace} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/90 via-dark/85 to-dark"></div>
  </div>

  <div class="relative z-10 section-padding page-container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="pulse-eyebrow fade-rise">Handcrafted with Pride</p>
      <h2 class="fade-rise mt-4 text-foreground" style="--reveal-delay: 60ms">Shop Ghana</h2>
      <p class="fade-rise mx-auto mt-6 max-w-2xl text-base leading-relaxed text-foreground/70" style="--reveal-delay: 100ms">
        Every item is a piece of Ghana, woven, carved, dyed, and shaped by the hands of master
        artisans. Take home more than a souvenir; take home a legacy.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {marketplaceItems.map((item, i) => (
        <article class="pulse-card fade-rise" style={`--reveal-delay: ${i * 70}ms`}>
          <p class="text-[0.65rem] font-semibold uppercase tracking-nav text-ghana-gold">{item.category}</p>
          <h3 class="mt-3 text-lg text-foreground">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-foreground/65">{item.description}</p>
          <p class="mt-4 text-[0.65rem] font-semibold uppercase tracking-nav text-foreground/45">
            Available at Festival
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #marketplace .section-bg-image > img {
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
