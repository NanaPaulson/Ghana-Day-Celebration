---
import { cultureImages } from '../data/culture-images';

const marketplaceVisuals = [
  {
    image: cultureImages.marketplace,
    category: 'Craft & Textiles',
    title: 'Woven heritage',
    alt: 'Ghanaian marketplace stall displaying woven baskets, beads, cloth, and handmade goods',
  },
  {
    image: '/images/gallery/marketplace-vendor-booth.jpg',
    category: 'Baskets & Beads',
    title: 'Made to be carried home',
    alt: 'Ghanaian vendor arranging baskets, jewelry, carved figures, and colorful textiles',
  },
  {
    image: '/images/gallery/fashion-traditional-portrait.jpg',
    category: 'Fashion',
    title: 'Wear the culture',
    alt: 'Ghanaian-inspired fashion portrait featuring a traditional patterned outfit',
  },
  {
    image: cultureImages.food,
    category: 'Taste of Ghana',
    title: 'Gather around flavor',
    alt: 'Traditional Ghanaian food prepared for a shared celebration meal',
  },
] as const;
---

<section id="marketplace" data-header-theme="dark" class="pulse-section relative min-h-[70vh] editorial-section marketplace-section">
  <div class="section-bg-image" aria-hidden="true">
    <img src={cultureImages.marketplace} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-gradient-to-b from-dark/80 via-dark/70 to-dark/88"></div>
  </div>
  <div class="marketplace-art" aria-hidden="true">CRAFT</div>

  <div class="relative z-10 section-padding page-container">
    <div class="marketplace-layout">
      <header class="marketplace-heading">
      <p class="pulse-eyebrow fade-rise">Handcrafted with Pride</p>
        <h2 class="fade-rise mt-4 text-foreground" style="--reveal-delay: 60ms">Shop Ghana</h2>
        <p class="fade-rise mt-6 max-w-md text-base leading-relaxed text-foreground/75 md:text-lg" style="--reveal-delay: 100ms">
          Every item is a piece of Ghana, woven, carved, dyed, and shaped by the hands of master
          artisans. Take home more than a souvenir; take home a legacy.
        </p>
        <div class="marketplace-heading__note fade-rise" style="--reveal-delay: 140ms">
          <span>Festival marketplace</span>
          <span>{String(marketplaceVisuals.length).padStart(2, '0')} / visual highlights</span>
        </div>
      </header>

      <div class="marketplace-grid" data-stagger>
        {marketplaceVisuals.map((item, i) => (
          <article class="marketplace-card pulse-card fade-rise" style={`--reveal-delay: ${i * 70}ms`}>
            <img src={item.image} alt={item.alt} loading="lazy" decoding="async" />
            <div class="marketplace-card__overlay">
              <div class="marketplace-card__top">
                <span>0{i + 1}</span>
                <p>{item.category}</p>
              </div>
              <h3>{item.title}</h3>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marketplace-section {
    isolation: isolate;
  }

  .marketplace-art {
    position: absolute;
    right: -0.04em;
    bottom: -0.12em;
    z-index: 1;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(9rem, 23vw, 24rem);
    font-weight: 900;
    line-height: 0.7;
    letter-spacing: -0.08em;
    -webkit-text-stroke: 1px rgb(244 241 234 / 0.08);
    pointer-events: none;
    user-select: none;
  }

  .marketplace-layout {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .marketplace-heading {
    max-width: 34rem;
  }

  .marketplace-heading h2 {
    max-width: 7ch;
    font-size: clamp(3.4rem, 8vw, 7rem);
    line-height: 0.8;
  }

  .marketplace-heading__note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(244 241 234 / 0.2);
    color: rgb(244 241 234 / 0.5);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .marketplace-heading__note span:last-child {
    color: var(--color-gold);
  }

  .marketplace-grid {
    display: grid;
    gap: 0.75rem;
    grid-auto-rows: minmax(12.5rem, auto);
  }

  .marketplace-card {
    position: relative;
    min-height: 17rem;
    overflow: hidden;
    border-color: rgb(244 241 234 / 0.16);
    background: rgb(14 13 12 / 0.88);
  }

  .marketplace-card > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .marketplace-card:hover > img {
    transform: scale(1.04);
  }

  .marketplace-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: linear-gradient(180deg, rgb(8 7 6 / 0.15), rgb(8 7 6 / 0.84));
  }

  .marketplace-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .marketplace-card__top > span {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 0.72rem;
  }

  .marketplace-card__top p {
    color: var(--color-gold);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .marketplace-card h3 {
    max-width: 12ch;
    color: var(--color-foreground);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 2.1rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .marketplace-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .marketplace-layout {
      grid-template-columns: minmax(17rem, 0.72fr) minmax(0, 1.28fr);
      gap: clamp(3rem, 7vw, 8rem);
    }

    .marketplace-grid {
      gap: 1rem;
    }

    .marketplace-card {
      min-height: 20rem;
    }

    .marketplace-section .section-padding {
      padding-bottom: clamp(6rem, 10vw, 10rem);
    }
  }

  @media (max-width: 767px) {
    .marketplace-art {
      bottom: 0;
      font-size: 8rem;
    }
  }

  #marketplace .section-bg-image > img {
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
