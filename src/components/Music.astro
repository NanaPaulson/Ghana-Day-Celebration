---
import AdinkraSymbol from './AdinkraSymbol.astro';
import { musicGenres } from '../data/pulse';

const beatHeights = [22, 46, 74, 38, 88, 56, 30, 68, 96, 48, 76, 34, 62, 84, 42, 70, 28, 52, 80, 36, 64, 24];
const genreMeta = [
  { accent: 'gold', label: 'Guitars / Horns / Groove' },
  { accent: 'green', label: 'Movement / Energy / Joy' },
  { accent: 'red', label: 'Fontomfrom / Kpanlogo / Adowa' },
  { accent: 'gold', label: 'Heritage / Future / Global' },
] as const;
---

<section id="music" data-header-theme="dark" class="music-section pulse-section relative overflow-hidden">
  <div class="rhythm-flag-line" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>

  <div class="rhythm-backdrop" aria-hidden="true">
    <span class="rhythm-backdrop__word rhythm-backdrop__word--one">RHYTHM</span>
    <span class="rhythm-backdrop__word rhythm-backdrop__word--two">RHYTHM</span>
    <div class="rhythm-backdrop__disc rhythm-backdrop__disc--left"></div>
    <div class="rhythm-backdrop__disc rhythm-backdrop__disc--right"></div>
  </div>

  <div class="rhythm-shell relative z-10 section-padding">
    <div class="rhythm-hero grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div id="music-showcase" class="rhythm-copy">
        <p class="rhythm-kicker">
          <span class="rhythm-kicker__beat" aria-hidden="true"></span>
          Feel the Beat of Ghana
        </p>

        <h2 class="rhythm-title mt-6 text-foreground">
          <span class="rhythm-title__small">Where</span>
          <span class="rhythm-title__gold">Rhythm</span>
          <span class="rhythm-title__outline">Becomes</span>
          <span class="rhythm-title__last">Language</span>
        </h2>

        <p class="rhythm-lead mt-7">
          Experience cultural performances with traditional and contemporary music and dance exhibitions
          throughout the day.
        </p>

        <div class="rhythm-spectrum mt-8" aria-hidden="true">
          {beatHeights.map((height, index) => (
            <span style={`--bar-height: ${height}%; --bar-delay: ${index * 38}ms`}></span>
          ))}
        </div>

        <div class="rhythm-copy__footer mt-7" aria-hidden="true">
          <span>Ancient pulse</span>
          <i></i>
          <span>Modern movement</span>
        </div>
      </div>

      <div class="rhythm-stage" aria-hidden="true">
        <div class="rhythm-stage__caption rhythm-stage__caption--top">Sound of a people</div>
        <div class="rhythm-stage__caption rhythm-stage__caption--bottom">Tampa Bay / 2026</div>

        <div class="rhythm-pulse-ring rhythm-pulse-ring--one"></div>
        <div class="rhythm-pulse-ring rhythm-pulse-ring--two"></div>
        <div class="rhythm-pulse-ring rhythm-pulse-ring--three"></div>

        <svg class="rhythm-drum" viewBox="0 0 560 560" focusable="false">
          <defs>
            <linearGradient id="drum-body" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#3b2a1c"></stop>
              <stop offset="0.52" stop-color="#201711"></stop>
              <stop offset="1" stop-color="#0f0b08"></stop>
            </linearGradient>
            <linearGradient id="drum-rim" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#ba7511"></stop>
              <stop offset="0.5" stop-color="#f2a900"></stop>
              <stop offset="1" stop-color="#8a500a"></stop>
            </linearGradient>
            <radialGradient id="drum-head">
              <stop offset="0" stop-color="#e2bc7a"></stop>
              <stop offset="0.7" stop-color="#b77b31"></stop>
              <stop offset="1" stop-color="#6f4319"></stop>
            </radialGradient>
            <filter id="drum-shadow" x="-40%" y="-40%" width="180%" height="180%">
              <feDropShadow dx="0" dy="22" stdDeviation="18" flood-color="#000" flood-opacity=".55"></feDropShadow>
            </filter>
          </defs>

          <g class="rhythm-sticks">
            <path d="M105 72 L438 420" stroke="#9f6426" stroke-width="18" stroke-linecap="round"></path>
            <path d="M455 68 L124 421" stroke="#c88a3b" stroke-width="18" stroke-linecap="round"></path>
            <path d="M105 72 L438 420" stroke="#e2ad63" stroke-width="3" stroke-linecap="round" opacity=".55"></path>
            <path d="M455 68 L124 421" stroke="#f2c47c" stroke-width="3" stroke-linecap="round" opacity=".55"></path>
          </g>

          <g filter="url(#drum-shadow)">
            <path d="M146 163 Q280 210 414 163 L379 435 Q280 487 181 435 Z" fill="url(#drum-body)" stroke="#f2a900" stroke-width="4"></path>
            <path d="M153 214 Q280 254 407 214" fill="none" stroke="url(#drum-rim)" stroke-width="16"></path>
            <path d="M176 390 Q280 432 384 390" fill="none" stroke="url(#drum-rim)" stroke-width="15"></path>
            <ellipse cx="280" cy="158" rx="139" ry="54" fill="url(#drum-head)" stroke="url(#drum-rim)" stroke-width="13"></ellipse>
            <ellipse cx="280" cy="153" rx="112" ry="36" fill="#e6c48b" opacity=".58"></ellipse>

            <g fill="none" stroke="#d99500" stroke-width="5" opacity=".8">
              <path d="M166 188 L203 416"></path>
              <path d="M207 203 L229 451"></path>
              <path d="M394 188 L357 416"></path>
              <path d="M353 203 L331 451"></path>
            </g>

            <g fill="#f2a900">
              <circle cx="166" cy="188" r="7"></circle>
              <circle cx="207" cy="203" r="7"></circle>
              <circle cx="394" cy="188" r="7"></circle>
              <circle cx="353" cy="203" r="7"></circle>
              <circle cx="203" cy="416" r="7"></circle>
              <circle cx="229" cy="451" r="7"></circle>
              <circle cx="357" cy="416" r="7"></circle>
              <circle cx="331" cy="451" r="7"></circle>
            </g>
          </g>
        </svg>

        <div class="rhythm-drum__symbol">
          <AdinkraSymbol symbol="gye-nyame" class="h-full w-full" />
        </div>

        <div class="rhythm-stage__spark rhythm-stage__spark--one"></div>
        <div class="rhythm-stage__spark rhythm-stage__spark--two"></div>
        <div class="rhythm-stage__spark rhythm-stage__spark--three"></div>
      </div>
    </div>

    <div class="rhythm-program mt-16 lg:mt-24">
      <div class="rhythm-program__header">
        <p>Four sounds. One heartbeat.</p>
        <div aria-hidden="true"><span></span><i></i><span></span></div>
        <p>Live cultural soundscape</p>
      </div>

      <div class="rhythm-deck mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {musicGenres.map((genre, i) => (
          <article
            class:list={[
              'genre-sleeve',
              `genre-sleeve--${genreMeta[i].accent}`,
              'border',
              'border-foreground/10',
              'bg-dark-card',
              'p-6',
            ]}
            style={`--reveal-delay: ${180 + i * 80}ms`}
          >
            <div class="genre-sleeve__face">
              <div class="genre-sleeve__top">
                <span class="genre-sleeve__number">0{i + 1}</span>
                <span class="genre-sleeve__dot"></span>
              </div>

              <div class="genre-sleeve__grooves" aria-hidden="true">
                <i></i><i></i><i></i>
              </div>

              <p class="genre-sleeve__label">{genreMeta[i].label}</p>
              <h3>{genre.title}</h3>
              <p class="genre-sleeve__copy">{genre.description}</p>

              <div class="genre-sleeve__wave" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Immersive rhythm-stage redesign */
  .music-section {
    min-height: 100vh;
    isolation: isolate;
    color: var(--color-foreground);
    background:
      radial-gradient(circle at 72% 31%, rgb(242 169 0 / 0.11), transparent 22%),
      radial-gradient(circle at 96% 90%, rgb(200 16 46 / 0.15), transparent 32%),
      radial-gradient(circle at 4% 68%, rgb(0 107 63 / 0.12), transparent 30%),
      linear-gradient(125deg, #0d0b09 0%, #1e1813 48%, #0f0c0a 100%);
  }

  .rhythm-flag-line {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 5px;
  }

  .rhythm-flag-line span:nth-child(1) { background: var(--color-red); }
  .rhythm-flag-line span:nth-child(2) { background: var(--color-gold); }
  .rhythm-flag-line span:nth-child(3) { background: var(--color-green); }

  .rhythm-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .rhythm-backdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image:
      linear-gradient(30deg, rgb(242 169 0 / 0.08) 12%, transparent 12.5%, transparent 87%, rgb(242 169 0 / 0.08) 87.5%),
      linear-gradient(150deg, rgb(242 169 0 / 0.08) 12%, transparent 12.5%, transparent 87%, rgb(242 169 0 / 0.08) 87.5%);
    background-size: 70px 122px;
    mask-image: radial-gradient(ellipse at center, black, transparent 72%);
  }

  .rhythm-backdrop__word {
    position: absolute;
    font-family: var(--font-display);
    font-size: clamp(8rem, 20vw, 23rem);
    font-weight: 900;
    line-height: 0.75;
    letter-spacing: -0.07em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(244 241 234 / 0.05);
    white-space: nowrap;
    user-select: none;
  }

  .rhythm-backdrop__word--one { top: 4%; left: -5%; }
  .rhythm-backdrop__word--two { right: -9%; bottom: 7%; }

  .rhythm-backdrop__disc {
    position: absolute;
    border: 1px solid rgb(242 169 0 / 0.13);
    border-radius: 50%;
    box-shadow:
      0 0 0 34px rgb(242 169 0 / 0.025),
      0 0 0 68px rgb(242 169 0 / 0.018);
  }

  .rhythm-backdrop__disc::before,
  .rhythm-backdrop__disc::after {
    content: '';
    position: absolute;
    border-radius: inherit;
    border: 1px dashed rgb(244 241 234 / 0.07);
  }

  .rhythm-backdrop__disc::before { inset: 18%; }
  .rhythm-backdrop__disc::after { inset: 38%; }

  .rhythm-backdrop__disc--left {
    width: 380px;
    height: 380px;
    left: -230px;
    top: 30%;
  }

  .rhythm-backdrop__disc--right {
    width: 520px;
    height: 520px;
    right: -310px;
    bottom: 3%;
  }

  .rhythm-shell {
    width: min(100% - 2rem, 1380px);
    margin-inline: auto;
  }

  .rhythm-hero {
    min-height: 720px;
  }

  .rhythm-copy {
    max-width: 670px;
  }

  .rhythm-kicker {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-gold);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .rhythm-kicker__beat {
    position: relative;
    width: 48px;
    height: 1px;
    background: var(--color-gold);
  }

  .rhythm-kicker__beat::after {
    content: '';
    position: absolute;
    right: 8px;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-gold);
    transform: translateY(-50%);
    box-shadow: 0 0 0 5px rgb(242 169 0 / 0.12);
  }

  .rhythm-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: clamp(3.2rem, 7.4vw, 7.6rem);
    line-height: 0.76;
    letter-spacing: -0.055em;
  }

  .rhythm-title__small {
    margin-left: 0.08em;
    font-size: 0.38em;
    letter-spacing: 0.04em;
  }

  .rhythm-title__gold { color: var(--color-gold); }

  .rhythm-title__outline {
    margin-left: 0.22em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(244 241 234 / 0.76);
  }

  .rhythm-title__last { margin-left: 0.05em; }

  .rhythm-lead {
    max-width: 590px;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-red);
    color: rgb(244 241 234 / 0.7);
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.75;
  }

  .rhythm-spectrum {
    display: flex;
    align-items: center;
    gap: clamp(3px, 0.45vw, 8px);
    width: min(100%, 520px);
    height: 68px;
  }

  .rhythm-spectrum span {
    width: 4px;
    height: var(--bar-height);
    min-height: 8px;
    border-radius: 999px;
    background: linear-gradient(to top, var(--color-red), var(--color-gold));
    transform-origin: center;
    animation: spectrum-dance 1.35s ease-in-out var(--bar-delay) infinite alternate;
  }

  @keyframes spectrum-dance {
    to { opacity: 0.42; transform: scaleY(0.35); }
  }

  .rhythm-copy__footer {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: rgb(244 241 234 / 0.42);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rhythm-copy__footer i {
    width: clamp(38px, 6vw, 76px);
    height: 1px;
    background: linear-gradient(90deg, var(--color-red), var(--color-gold), var(--color-green));
  }

  .rhythm-stage {
    position: relative;
    min-height: 590px;
    display: grid;
    place-items: center;
  }

  .rhythm-stage::before {
    content: '';
    position: absolute;
    width: min(92%, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: repeating-conic-gradient(from 0deg, rgb(242 169 0 / 0.18) 0deg 1deg, transparent 1deg 10deg);
    mask-image: radial-gradient(circle, transparent 0 56%, black 57% 58%, transparent 59%);
    animation: stage-rotate 45s linear infinite;
  }

  @keyframes stage-rotate {
    to { transform: rotate(360deg); }
  }

  .rhythm-drum {
    position: relative;
    z-index: 3;
    width: min(100%, 570px);
    overflow: visible;
    transform: rotate(1.5deg);
  }

  .rhythm-sticks {
    transform-origin: center;
    animation: sticks-breathe 3.5s ease-in-out infinite alternate;
  }

  @keyframes sticks-breathe {
    to { transform: rotate(2deg); }
  }

  .rhythm-drum__symbol {
    position: absolute;
    z-index: 4;
    top: 54%;
    left: 50%;
    width: 92px;
    height: 92px;
    color: var(--color-gold);
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 4px 12px rgb(0 0 0 / 0.5));
  }

  .rhythm-pulse-ring {
    position: absolute;
    z-index: 1;
    border: 1px solid rgb(242 169 0 / 0.24);
    border-radius: 50%;
  }

  .rhythm-pulse-ring--one {
    width: 330px;
    height: 330px;
    animation: ring-pulse 3s ease-out infinite;
  }

  .rhythm-pulse-ring--two {
    width: 430px;
    height: 430px;
    border-color: rgb(200 16 46 / 0.2);
    animation: ring-pulse 3s 1s ease-out infinite;
  }

  .rhythm-pulse-ring--three {
    width: 530px;
    height: 530px;
    border-color: rgb(0 107 63 / 0.2);
    animation: ring-pulse 3s 2s ease-out infinite;
  }

  @keyframes ring-pulse {
    0% { opacity: 0.85; transform: scale(0.82); }
    100% { opacity: 0; transform: scale(1.08); }
  }

  .rhythm-stage__caption {
    position: absolute;
    z-index: 5;
    writing-mode: vertical-rl;
    color: rgb(244 241 234 / 0.42);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .rhythm-stage__caption--top { top: 12%; right: 2%; }
  .rhythm-stage__caption--bottom { bottom: 9%; left: 3%; transform: rotate(180deg); }

  .rhythm-stage__spark {
    position: absolute;
    z-index: 6;
    width: 8px;
    height: 8px;
    background: var(--color-gold);
    transform: rotate(45deg);
    box-shadow: 0 0 18px rgb(242 169 0 / 0.7);
  }

  .rhythm-stage__spark--one { top: 18%; left: 14%; }
  .rhythm-stage__spark--two { right: 10%; bottom: 28%; width: 5px; height: 5px; background: var(--color-red); }
  .rhythm-stage__spark--three { left: 13%; bottom: 14%; width: 4px; height: 4px; background: var(--color-green); }

  .rhythm-program {
    position: relative;
  }

  .rhythm-program__header {
    display: grid;
    grid-template-columns: auto minmax(70px, 1fr) auto;
    align-items: center;
    gap: 1rem;
    color: rgb(244 241 234 / 0.52);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rhythm-program__header > div {
    display: flex;
    align-items: center;
  }

  .rhythm-program__header > div span {
    flex: 1;
    height: 1px;
    background: rgb(244 241 234 / 0.14);
  }

  .rhythm-program__header > div i {
    width: 9px;
    height: 9px;
    margin-inline: 0.65rem;
    border: 2px solid var(--color-gold);
    border-radius: 50%;
  }

  .rhythm-deck {
    align-items: stretch;
  }

  .genre-sleeve {
    --sleeve-accent: var(--color-gold);
    position: relative;
    min-height: 350px;
    overflow: hidden;
    border-top: 4px solid var(--sleeve-accent);
    border-radius: 0;
    background: rgb(36 30 25 / 0.96);
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--sleeve-accent) 12%, transparent), transparent 52%),
      rgb(36 30 25 / 0.96);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.3);
    clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 0 100%);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .genre-sleeve::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 30px;
    height: 30px;
    background: var(--sleeve-accent);
    opacity: 0.55;
    clip-path: polygon(0 0, 100% 100%, 0 100%);
  }

  .genre-sleeve::after {
    content: '';
    position: absolute;
    right: -94px;
    top: 58px;
    width: 210px;
    height: 210px;
    border: 1px solid rgb(242 169 0 / 0.22);
    border-radius: 50%;
    box-shadow:
      0 0 0 18px rgb(255 255 255 / 0.018),
      0 0 0 38px rgb(255 255 255 / 0.012),
      inset 0 0 0 46px rgb(0 0 0 / 0.11);
  }

  .genre-sleeve--green { --sleeve-accent: var(--color-green); }
  .genre-sleeve--red { --sleeve-accent: var(--color-red); }

  .genre-sleeve__face {
    position: relative;
    z-index: 2;
    height: 100%;
  }

  .genre-sleeve__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .genre-sleeve__number {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    color: rgb(244 241 234 / 0.46);
  }

  .genre-sleeve__dot {
    width: 7px;
    height: 7px;
    margin-right: 1.5rem;
    border-radius: 50%;
    background: var(--sleeve-accent);
    box-shadow: 0 0 0 6px rgb(242 169 0 / 0.1);
  }

  .genre-sleeve__grooves {
    position: relative;
    width: 74px;
    height: 74px;
    margin-top: 2.25rem;
    border: 1px solid var(--sleeve-accent);
    border-radius: 50%;
    opacity: 0.8;
  }

  .genre-sleeve__grooves::before,
  .genre-sleeve__grooves::after,
  .genre-sleeve__grooves i {
    content: '';
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--sleeve-accent);
    opacity: 0.55;
  }

  .genre-sleeve__grooves::before { inset: 10px; }
  .genre-sleeve__grooves::after { inset: 29px; background: var(--sleeve-accent); border: 0; opacity: 1; }
  .genre-sleeve__grooves i:nth-child(1) { inset: 5px; }
  .genre-sleeve__grooves i:nth-child(2) { inset: 16px; }
  .genre-sleeve__grooves i:nth-child(3) { inset: 24px; }

  .genre-sleeve__label {
    margin-top: 2rem;
    color: var(--sleeve-accent);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .genre-sleeve h3 {
    max-width: 12ch;
    margin-top: 0.65rem;
    color: var(--color-foreground);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1;
  }

  .genre-sleeve__copy {
    max-width: 27ch;
    margin-top: 1rem;
    color: rgb(244 241 234 / 0.68);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .genre-sleeve__wave {
    display: flex;
    align-items: end;
    gap: 3px;
    height: 24px;
    margin-top: 1.5rem;
  }

  .genre-sleeve__wave span {
    display: block;
    width: 3px;
    border-radius: 2px;
    background: var(--sleeve-accent);
  }

  .genre-sleeve__wave span:nth-child(1) { height: 8px; }
  .genre-sleeve__wave span:nth-child(2) { height: 18px; }
  .genre-sleeve__wave span:nth-child(3) { height: 12px; }
  .genre-sleeve__wave span:nth-child(4) { height: 24px; }
  .genre-sleeve__wave span:nth-child(5) { height: 14px; }
  .genre-sleeve__wave span:nth-child(6) { height: 20px; }
  .genre-sleeve__wave span:nth-child(7) { height: 7px; }

  @media (min-width: 1024px) {
    .rhythm-hero {
      grid-template-columns: minmax(0, 0.93fr) minmax(440px, 1.07fr);
    }

    .genre-sleeve:nth-child(2),
    .genre-sleeve:nth-child(4) {
      transform: translateY(22px);
    }
  }

  @media (max-width: 1023px) {
    .rhythm-hero { min-height: 0; }
    .rhythm-copy { max-width: 760px; }
    .rhythm-stage { min-height: 540px; }
  }

  @media (max-width: 639px) {
    .rhythm-shell { width: min(100% - 1rem, 1380px); }
