---
import { EVENT_DATE, VENUE } from '../constants';
---

<section id="schedule" data-header-theme="dark" class="section-padding editorial-section schedule-section">
  <div class="page-container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="pulse-eyebrow fade-rise">Plan Your Day</p>
      <h2 class="fade-rise mt-4 text-foreground" style="--reveal-delay: 60ms">Activities for the Day</h2>
      <p class="fade-rise mx-auto mt-6 max-w-2xl text-base leading-relaxed text-foreground/70" style="--reveal-delay: 100ms">
        Activities and programming for {EVENT_DATE} at {VENUE.name}, {VENUE.city} are being finalized.
      </p>
    </div>

    <div class="schedule-coming-soon fade-rise mx-auto mt-14 max-w-3xl" style="--reveal-delay: 140ms">
      <span class="schedule-coming-soon__line" aria-hidden="true"></span>
      <p class="schedule-coming-soon__label">Coming Soon</p>
      <p class="schedule-coming-soon__copy">The full program will be announced once the day’s activities are confirmed.</p>
      <span class="schedule-coming-soon__line" aria-hidden="true"></span>
    </div>

  </div>
</section>

<style>
  .schedule-coming-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem;
    border-top: 1px solid rgb(242 169 0 / 0.3);
    border-bottom: 1px solid rgb(242 169 0 / 0.3);
    text-align: center;
    background: linear-gradient(135deg, rgb(242 169 0 / 0.08), rgb(14 13 12 / 0.2));
  }

  .schedule-coming-soon__line {
    width: 3rem;
    height: 2px;
    background: var(--color-gold);
  }

  .schedule-coming-soon__label {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 2.25rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .schedule-coming-soon__copy {
    max-width: 30rem;
    color: rgb(244 241 234 / 0.7);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .schedule-section {
    color: var(--color-dark);
    background: #f4f1ea;
  }

  .schedule-section h2 {
    color: var(--color-dark);
  }

  .schedule-section .text-foreground\/70 {
    color: rgb(14 13 12 / 0.68);
  }

  .schedule-coming-soon {
    background: linear-gradient(135deg, rgb(242 169 0 / 0.12), rgb(255 255 255 / 0.8));
  }

  .schedule-coming-soon__copy {
    color: rgb(14 13 12 / 0.7);
  }
</style>
