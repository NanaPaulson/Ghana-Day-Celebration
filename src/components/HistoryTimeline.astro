---
import { historyTimeline } from '../data/pulse';
---

<section id="history" data-header-theme="dark" class="pulse-section relative min-h-[90vh]">
  <div class="section-bg-image" aria-hidden="true">
    <img src="/images/pulse/history-castle.png" alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-dark/88"></div>
  </div>

  <div class="relative z-10 section-padding page-container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="pulse-eyebrow fade-rise">Ghana Through the Ages</p>
      <h2 class="fade-rise mt-4 text-foreground" style="--reveal-delay: 60ms">
        From Empire<br />to Independence
      </h2>
    </div>

    <div class="relative mx-auto mt-16 max-w-2xl">
      <div class="absolute bottom-0 left-4 top-0 w-px bg-ghana-gold/30 sm:left-1/2 sm:-translate-x-px" aria-hidden="true"></div>

      <ol class="space-y-10">
        {historyTimeline.map((item, i) => (
          <li
            class={`fade-rise relative grid gap-4 pl-10 sm:grid-cols-2 sm:gap-8 sm:pl-0 ${i % 2 === 0 ? '' : 'sm:[&>div:first-child]:order-2'}`}
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <div class={`${i % 2 === 0 ? 'sm:text-right sm:pr-10' : 'sm:text-left sm:pl-10'}`}>
              <p class="font-display text-2xl text-ghana-gold">{item.year}</p>
            </div>
            <div class={`${i % 2 === 0 ? 'sm:pl-10' : 'sm:pr-10 sm:text-right'}`}>
              <p class="text-sm leading-relaxed text-foreground/75 sm:text-base">{item.text}</p>
            </div>
            <span
              class="timeline-marker absolute left-4 top-1 h-2 w-2 -translate-x-1/2 rounded-full bg-ghana-gold sm:left-1/2"
              aria-hidden="true"
            ></span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  #history .section-bg-image > img {
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
