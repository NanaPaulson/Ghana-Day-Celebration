---
import { VENUE } from '../constants';

const encodedAddress = encodeURIComponent(VENUE.mapsQuery);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodedAddress}`;
const appleMapsUrl = `https://maps.apple.com/?address=${encodedAddress}`;
const embedUrl = `https://maps.google.com/maps?q=${VENUE.lat},${VENUE.lng}&z=16&output=embed`;
---

<section id="getting-there" data-header-theme="dark" class="section-dark section-padding">
  <div class="page-container">
    <p class="pulse-eyebrow fade-rise">Find Us</p>
    <h2 class="fade-rise mt-4 text-foreground">Getting There</h2>

    <div class="fade-rise mt-8">
      <address class="not-italic text-base text-foreground/75">
        <strong class="text-foreground">{VENUE.name}</strong><br />
        {VENUE.street}<br />
        {VENUE.city}, {VENUE.state} {VENUE.zip}
      </address>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-foreground/65">
        Rowlett Park is in Tampa, Florida, United States, convenient for visitors traveling from across
        Florida and neighboring states.
      </p>
    </div>

    <div class="getting-there-map fade-rise mt-8">
      <div class="getting-there-map__frame">
        <iframe
          src={embedUrl}
          title="Rowlett Park, 2401 E Yukon St, Tampa, FL 33604 on Google Maps"
          width="100%"
          height="100%"
          loading="lazy"
          class="getting-there-map__embed"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <div class="getting-there-map__actions" data-stagger>
        <a
          href={googleMapsUrl}
          class="getting-there-map__btn scale-in btn-vendor"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in Google Maps
        </a>
        <a
          href={appleMapsUrl}
          class="getting-there-map__btn scale-in btn-vendor"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in Apple Maps
        </a>
      </div>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <article class="pulse-card fade-rise">
        <h3 class="text-lg text-foreground">Parking</h3>
        <p class="mt-2 text-sm leading-relaxed text-foreground/75">
          Parking details will be confirmed closer to the event. Check back for lot locations and any fees.
        </p>
      </article>
      <article class="pulse-card fade-rise">
        <h3 class="text-lg text-foreground">Public Transit</h3>
        <p class="mt-2 text-sm leading-relaxed text-foreground/75">
          Public transit options to Rowlett Park will be posted here. HART bus routes serve the Tampa area.
        </p>
      </article>
      <article class="pulse-card fade-rise">
        <h3 class="text-lg text-foreground">Accessibility</h3>
        <p class="mt-2 text-sm leading-relaxed text-foreground/75">
          The venue is accessible. Specific accessibility accommodations will be listed here once confirmed.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .getting-there-map {
    overflow: hidden;
    border-radius: 0.375rem;
    border: 1px solid rgb(244 241 234 / 0.12);
    box-shadow: 0 18px 48px rgb(0 0 0 / 0.28);
  }

  .getting-there-map__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background: var(--color-dark-card);
  }

  .getting-there-map__embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.12s,
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }

  .getting-there-map.is-visible .getting-there-map__embed {
    opacity: 1;
    transform: scale(1);
  }

  .getting-there-map__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem 1rem;
    padding: 1.125rem 1.25rem;
    background: var(--color-cream);
    border-top: 1px solid rgb(26 22 19 / 0.08);
  }

  @media (min-width: 640px) {
    .getting-there-map__actions {
      padding: 1.25rem 1.5rem;
    }
  }

  .getting-there-map__btn {
    flex: 1 1 12rem;
    min-width: min(100%, 14rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .getting-there-map__embed {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
