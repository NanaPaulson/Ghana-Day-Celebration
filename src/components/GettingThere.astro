---
import { VENUE } from '../constants';

const encodedAddress = encodeURIComponent(VENUE.mapsQuery);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodedAddress}`;
const appleMapsUrl = `https://maps.apple.com/?address=${encodedAddress}`;
const embedUrl = `https://maps.google.com/maps?q=${VENUE.lat},${VENUE.lng}&z=16&output=embed`;
---

<section id="getting-there" data-header-theme="dark" class="section-padding editorial-section getting-there-section">
  <div class="page-container">
    <div class="getting-there-layout">
      <div class="getting-there-copy fade-rise">
        <p class="pulse-eyebrow">Find Us</p>
        <h2 class="mt-4 text-foreground">The gathering place.</h2>
        <p class="getting-there-intro mt-6 text-base leading-relaxed text-foreground/75 md:text-lg">
          Ghana Day comes together at Rowlett Park, a welcoming Tampa destination with room for
          music, food, family, and community.
        </p>

        <address class="getting-there-address mt-8 not-italic">
          <span class="getting-there-address__label">Ghana Day 2026</span>
          <strong>{VENUE.name}</strong>
          <span>{VENUE.street}</span>
          <span>{VENUE.city}, {VENUE.state} {VENUE.zip}</span>
        </address>

        <div class="getting-there-coordinates mt-8" aria-label="Venue coordinates">
          <span>27°59'49.0&quot;N</span>
          <span>-82°25'56.0&quot;W</span>
        </div>
      </div>

      <div class="getting-there-map fade-rise" style="--reveal-delay: 120ms">
        <div class="getting-there-map__header">
          <span>Rowlett Park / Tampa, Florida</span>
          <span>09:00 AM</span>
        </div>
        <div class="getting-there-map__frame">
          <iframe
            src={embedUrl}
            title="Rowlett Park, 2401 E Yukon St, Tampa, FL 33604 on Google Maps"
            width="100%"
            height="100%"
            loading="lazy"
            class="getting-there-map__embed"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="getting-there-map__actions" data-stagger>
          <a href={googleMapsUrl} class="getting-there-map__btn scale-in btn-gold" target="_blank" rel="noopener noreferrer">
            Google Maps
          </a>
          <a href={appleMapsUrl} class="getting-there-map__btn scale-in btn-ghost" target="_blank" rel="noopener noreferrer">
            Apple Maps
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .getting-there-layout {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .getting-there-copy {
    max-width: 34rem;
  }

  .getting-there-copy h2 {
    max-width: 8ch;
    color: var(--color-dark);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.82;
  }

  .getting-there-intro {
    max-width: 30rem;
    color: rgb(14 13 12 / 0.72);
  }

  .getting-there-address {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--color-gold);
    color: rgb(14 13 12 / 0.72);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .getting-there-address__label {
    margin-bottom: 0.4rem;
    color: var(--color-gold);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .getting-there-address strong {
    color: var(--color-dark);
    font-size: 1.15rem;
  }

  .getting-there-coordinates {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: rgb(14 13 12 / 0.5);
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .getting-there-coordinates span + span {
    padding-left: 1rem;
    border-left: 1px solid rgb(244 241 234 / 0.2);
  }

  .getting-there-map {
    overflow: hidden;
    border: 1px solid rgb(14 13 12 / 0.16);
    background: #fff;
    box-shadow: 0 24px 60px rgb(14 13 12 / 0.14);
  }

  .getting-there-map__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 1rem;
    color: rgb(14 13 12 / 0.62);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .getting-there-map__header span:last-child {
    color: var(--color-gold);
  }

  .getting-there-map__frame {
    position: relative;
    aspect-ratio: 5 / 4;
    width: 100%;
    overflow: hidden;
    border-top: 1px solid rgb(244 241 234 / 0.1);
    border-bottom: 1px solid rgb(244 241 234 / 0.1);
    background: #0b0b0a;
  }

  .getting-there-map__embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transform: scale(1.03);
    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.12s,
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.12s;
  }

  .getting-there-map.is-visible .getting-there-map__embed {
    opacity: 1;
    transform: scale(1);
  }

  .getting-there-map__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--color-cream);
  }

  .getting-there-section {
    color: var(--color-dark);
    background: #f4f1ea;
  }

  .getting-there-map__btn {
    flex: 1 1 12rem;
    min-width: min(100%, 14rem);
  }

  @media (min-width: 1024px) {
    .getting-there-layout {
      grid-template-columns: minmax(18rem, 0.78fr) minmax(0, 1.22fr);
    }
  }

  @media (max-width: 639px) {
    .getting-there-map__header {
      flex-direction: column;
      gap: 0.3rem;
    }

    .getting-there-map__btn {
      flex-basis: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .getting-there-map__embed {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
