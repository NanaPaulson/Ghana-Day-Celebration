---
import { cultureImages } from '../data/culture-images';
import { communitySectors } from '../data/pulse';
import { CONTACT_EMAIL, CONTACT_PHONE, CONTACT_PHONE_DISPLAY, isPlaceholder } from '../constants';

const email = isPlaceholder(CONTACT_EMAIL) ? 'info@ghanadaytb.com' : CONTACT_EMAIL;
const emailHref = `mailto:${email}?subject=${encodeURIComponent('Ghana Day TB Community Inquiry')}`;
const phoneHref = `tel:${CONTACT_PHONE}`;
---

<section id="community" data-header-theme="dark" class="pulse-section relative min-h-[80vh]">
  <div class="section-bg-image" aria-hidden="true">
    <img src={cultureImages.ga} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
    <div class="absolute inset-0 bg-dark/76"></div>
  </div>

  <div class="relative z-10 section-padding page-container">
    <div class="community-intro mx-auto max-w-4xl text-center">
      <p class="pulse-eyebrow fade-rise">One Family, One Community</p>
      <h2 class="fade-rise mt-4 text-foreground md:text-5xl lg:text-6xl" style="--reveal-delay: 60ms">
        Connecting<br />Businesses &amp; Communities
      </h2>
      <p class="fade-rise mx-auto mt-6 max-w-3xl text-base leading-relaxed text-foreground/75 md:text-lg" style="--reveal-delay: 100ms">
        Ghanaian and African diaspora associations, businesses, and community groups are warmly
        invited to partner, sponsor, or participate in this celebration of unity, education, youth
        empowerment, and community development.
      </p>
    </div>

    <div class="community-sectors mx-auto mt-14 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {communitySectors.map((sector, i) => (
        <article class="pulse-card fade-rise min-h-40 p-6 md:p-7" style={`--reveal-delay: ${i * 80}ms`}>
          <h3 class="text-lg text-ghana-gold md:text-xl">{sector.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-foreground/75 md:text-base">{sector.description}</p>
        </article>
      ))}
    </div>

    <div class="community-contact fade-rise mx-auto mt-14 max-w-2xl pulse-card p-6 md:p-8" style="--reveal-delay: 240ms">
      <p class="pulse-eyebrow">Start a conversation</p>
      <h3 class="mt-3 text-xl text-foreground md:text-2xl">Bring your community to Ghana Day.</h3>
      <p class="mt-3 text-sm leading-relaxed text-foreground/70 md:text-base">
        Interested in partnering, sponsoring, exhibiting, or attending as an association? Reach the
        team directly and we will point you in the right direction.
      </p>

      <div class="mt-7 grid gap-3 sm:grid-cols-2">
        <a href={emailHref} class="btn-gold w-full">Email the Team</a>
        <a href={phoneHref} class="btn-ghost w-full">Call {CONTACT_PHONE_DISPLAY}</a>
      </div>
    </div>
  </div>
</section>

<style>
  #community .section-bg-image > img {
    max-width: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
