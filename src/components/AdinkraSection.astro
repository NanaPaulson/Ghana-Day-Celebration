---
import { adinkraSymbols } from '../data/pulse';
import AdinkraSymbol from './AdinkraSymbol.astro';

const symbolMap: Record<string, 'gye-nyame' | 'adinkrahene' | 'sankofa'> = {
  'gye-nyame': 'gye-nyame',
  'sankofa': 'sankofa',
  'adinkrahene': 'adinkrahene',
};
---

<section id="symbols" data-header-theme="light" class="section-light-deep section-padding">
  <div class="page-container">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow fade-rise">The Language of Symbols</p>
      <h2 class="fade-rise mt-4 text-balance text-ink" style="--reveal-delay: 60ms">
        Get The Chance To Learn &amp; Understand The Story Every Symbol Tells
      </h2>
      <p class="fade-rise mx-auto mt-6 max-w-2xl text-base leading-relaxed text-ink/75" style="--reveal-delay: 100ms">
        Adinkra symbols are visual representations of concepts and aphorisms from the Akan people of
        Ghana. Each symbol encodes wisdom passed down through centuries.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {adinkraSymbols.map((symbol, i) => (
        <article class="fade-rise relative overflow-hidden rounded border border-ghana-gold/25 bg-cream p-6 shadow-card" style={`--reveal-delay: ${i * 70}ms`}>
          {symbolMap[symbol.id] && (
            <AdinkraSymbol
              symbol={symbolMap[symbol.id]}
              class="absolute -right-4 -top-4 h-24 w-24 text-ghana-gold/10"
            />
          )}
          <h3 class="text-lg text-ghana-green">{symbol.name}</h3>
          <p class="mt-1 text-sm font-semibold italic text-ink/80">"{symbol.meaning}"</p>
          <p class="mt-3 text-sm leading-relaxed text-ink/70">{symbol.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
